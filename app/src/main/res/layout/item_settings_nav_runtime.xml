<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/nav_runtime_status"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="?attr/selectableItemBackground"
  android:clickable="true"
  android:focusable="true"
  android:gravity="center_vertical"
  android:minHeight="68dp"
  android:orientation="horizontal"
  android:paddingStart="18dp"
  android:paddingTop="14dp"
  android:paddingEnd="18dp"
  android:paddingBottom="14dp">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/settings_runtime_title"
      android:textColor="@color/xiaomei_host_text"
      android:textSize="16sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:text="@string/settings_runtime_subtitle"
      android:textColor="@color/xiaomei_host_subtext"
      android:textSize="13sp" />
  </LinearLayout>

  <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="›"
    android:textColor="@color/xiaomei_host_subtext"
    android:textSize="20sp" />
</LinearLayout>
