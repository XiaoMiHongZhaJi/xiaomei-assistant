<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      app:cardBackgroundColor="@color/xiaomei_host_primary"
      app:cardCornerRadius="20dp"
      app:strokeWidth="0dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="小美宿主接管"
          android:textColor="@color/xiaomei_host_primary_on"
          android:textSize="20sp"
          android:textStyle="bold" />

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:text="当前路线固定为 原版小米运动健康 3.55.0 + LSPosed 注入。复用官方 AIVS/ASR，仅替换官方 reply。"
          android:textColor="@color/xiaomei_host_primary_on"
          android:textSize="14sp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      app:cardBackgroundColor="@color/xiaomei_host_card"
      app:cardCornerRadius="20dp"
      app:strokeColor="@color/xiaomei_host_border"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="运行状态"
          android:textColor="@color/xiaomei_host_text"
          android:textSize="18sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/status_architecture"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_host"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_hook"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_pipeline"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_entry"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_asr"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_llm"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />

        <TextView
          android:id="@+id/status_error"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:textColor="@color/xiaomei_host_error"
          android:textSize="14sp"
          android:visibility="gone" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      app:cardBackgroundColor="@color/xiaomei_host_card"
      app:cardCornerRadius="20dp"
      app:strokeColor="@color/xiaomei_host_border"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="操作"
          android:textColor="@color/xiaomei_host_text"
          android:textSize="18sp"
          android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/action_open_llm"
          style="@style/Widget.Material3.Button"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="LLM 配置与测试" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/action_test_llm"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:text="直接测试当前配置" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      app:cardBackgroundColor="@color/xiaomei_host_card"
      app:cardCornerRadius="20dp"
      app:strokeColor="@color/xiaomei_host_border"
      app:strokeWidth="1dp">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="最近会话预览"
          android:textColor="@color/xiaomei_host_text"
          android:textSize="18sp"
          android:textStyle="bold" />

        <TextView
          android:id="@+id/status_recent_history"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="12dp"
          android:textColor="@color/xiaomei_host_subtext"
          android:textSize="14sp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

  </LinearLayout>
</ScrollView>
