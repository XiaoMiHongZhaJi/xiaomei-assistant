<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:scrollbars="none">

  <LinearLayout
    android:id="@+id/settings_main_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/settings_summary_title"
      android:textColor="@color/xiaomei_host_text"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:text="@string/settings_summary_body"
      android:textColor="@color/xiaomei_host_subtext"
      android:textSize="14sp" />

    <TextView
      android:id="@+id/summary_status"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="12dp"
      android:textColor="@color/xiaomei_host_text"
      android:textSize="15sp" />

    <TextView
      android:id="@+id/summary_host"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:textColor="@color/xiaomei_host_subtext"
      android:textSize="13sp" />

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:text="@string/settings_group_entry"
      android:textColor="@color/xiaomei_host_subtext"
      android:textSize="13sp"
      android:textStyle="bold" />

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:background="@color/xiaomei_host_card"
      android:orientation="vertical"
      android:showDividers="middle"
      android:divider="@drawable/settings_list_divider">

      <include
        android:id="@+id/nav_llm_config"
        layout="@layout/item_settings_nav_llm" />

      <include
        android:id="@+id/nav_runtime_status"
        layout="@layout/item_settings_nav_runtime" />

      <include
        android:id="@+id/nav_aivs_status"
        layout="@layout/item_settings_nav_aivs" />

      <include
        android:id="@+id/nav_history"
        layout="@layout/item_settings_nav_history" />

      <include
        android:id="@+id/nav_troubleshoot"
        layout="@layout/item_settings_nav_troubleshoot" />
    </LinearLayout>
  </LinearLayout>
</ScrollView>
