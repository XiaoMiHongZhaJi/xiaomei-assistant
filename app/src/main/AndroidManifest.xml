<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <application
    android:name=".XiaoMeiApplication"
    android:allowBackup="true"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:description="@string/xposed_description"
    android:useEmbeddedDex="false"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@style/Theme.XiaoMei"
    android:usesCleartextTraffic="true">

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:theme="@style/Theme.XiaoMei.ModuleUi">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
      </intent-filter>
    </activity>

    <activity-alias
      android:name=".activity.MainActivityAlias"
      android:exported="true"
      android:icon="@mipmap/ic_launcher"
      android:label="@string/app_name"
      android:targetActivity=".MainActivity"
      android:theme="@style/Theme.XiaoMei.ModuleUi">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity-alias>

    <activity
      android:name=".HostSettingsActivity"
      android:exported="false"
      android:theme="@style/Theme.XiaoMei" />

    <activity
      android:name=".settings.SettingsUiFragmentHostActivity"
      android:exported="true"
      android:theme="@style/Theme.XiaoMei.ModuleUi" />

    <service
      android:name=".sync.ModuleSyncService"
      android:exported="true" />

    <receiver
      android:name=".sync.ModuleSyncReceiver"
      android:exported="true" />
  </application>

  <queries>
    <package android:name="com.mi.health" />
    <package android:name="org.lsposed.manager" />
  </queries>

</manifest>
